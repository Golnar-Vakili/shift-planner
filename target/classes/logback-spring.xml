<?xml version="1.0" encoding="UTF-8"?>
<configuration>
	<include resource="org/springframework/boot/logging/logback/defaults.xml"/>
	<property name="LOG_FILE" value="${LOG_FILE:-${LOG_PATH:-${LOG_TEMP:-${java.io.tmpdir:-.}}/}spring.log}"/>
	<appender name="FILE" class="ch.qos.logback.core.FileAppender">
		<file>${LOG_FILE}</file>
		<encoder>
			<pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} %5p --- [%15.15t] %-40.40logger{39} : %m%n%wEx</pattern>
		</encoder>
	</appender>
	<root level="INFO">
		<appender-ref ref="CONSOLE"/>
		<appender-ref ref="FILE"/>
	</root>
	<!-- Log full stack traces on failure -->
	<logger name="org.springframework.boot.SpringApplication" level="DEBUG"/>
</configuration>
